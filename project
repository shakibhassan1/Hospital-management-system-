create or replace procedure show_patient
(
    p_id number
)
is
    p_name patient.patient_name%type;
begin
    select patient_name
    into p_name
    from patient
    where patient_id = p_id;

    dbms_output.put_line(p_name);
end;
/

exec show_patient(2023);

create or replace function get_bill
(
    b_id number
)
return number
is
    v_amount number;
begin
    select bill_amount
    into v_amount
    from bill
    where bill_id = b_id;

    return v_amount;
end;
/

select get_bill(6001)
from dual;

declare
    cursor c1 is
        select patient_name
        from patient;

    p_name patient.patient_name%type;

begin
    open c1;

    loop
        fetch c1 into p_name;

        exit when c1%notfound;

        dbms_output.put_line(p_name);
    end loop;

    close c1;
end;
/

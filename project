set linesize 10000;
set pagesize 10000;

create table department (
    department_id number primary key,
    department_name varchar2(50),
    department_location varchar2(50),
    department_openingTime varchar2(20),
    department_status varchar2(20)
);

create table doctor (
    doctor_id number primary key,
    doctor_name varchar2(50),
    doctor_phone varchar2(20),
    doctor_specialization varchar2(50),
    department_id number,
    foreign key (department_id) references department(department_id)
);

create table patient (
    patient_id number primary key,
    patient_name varchar2(50),
    patient_phone varchar2(20),
    patient_age number,
    patient_gender varchar2(20),
    doctor_id number,
    foreign key (doctor_id) references doctor(doctor_id)
);

create table appointment (
    appointment_id number primary key,
    appointment_date date,
    appointment_time varchar2(20),
    patient_id number,
    doctor_id number,
    foreign key (patient_id) references patient(patient_id),
    foreign key (doctor_id) references doctor(doctor_id)
);

create table medicine (
    medicine_id number primary key,
    medicine_name varchar2(50),
    medicine_price number(10,2),
    medicine_company varchar2(50),
    medicine_stock number
);

create table prescription (
    prescription_id number primary key,
    prescription_date date,
    patient_id number,
    doctor_id number,
    medicine_id number,
    dosage varchar2(50),
    foreign key (patient_id) references patient(patient_id),
    foreign key (doctor_id) references doctor(doctor_id),
    foreign key (medicine_id) references medicine(medicine_id)
);

create table bill (
    bill_id number primary key,
    bill_date date,
    patient_id number,
    bill_amount number(10,2),
    payment_status varchar2(20),
    foreign key (patient_id) references patient(patient_id)
);

